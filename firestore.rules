rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT: replace YOUR_ADMIN_EMAIL@example.com with the exact Admin login email.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['shafiq.jhe22@gmail.com'];
    }

    function signedIn() { return request.auth != null; }

    function isApproved() {
      return signedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved')
      );
    }

    match /users/{uid} {
      // An officer can create only their own pending profile.
      // The allowlisted Admin email can create its own Admin profile on first login.
      allow create: if signedIn() && request.auth.uid == uid && (
        (isAdmin()
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'approved')
        ||
        (request.resource.data.uid == uid
          && request.resource.data.role == 'officer'
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'uid','name','employeeId','designation','branch','mobile','email',
            'role','status','createdAt','passwordChangedAt'
          ]))
      );
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /customers/{recordId} {
      allow read: if isApproved() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isApproved()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.officerName is string;
      allow update: if isApproved()
        && (isAdmin() || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId));
      allow delete: if isApproved() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /surveys/{recordId} {
      allow read: if isApproved() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isApproved()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.officerName is string;
      allow update: if isApproved()
        && (isAdmin() || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId));
      allow delete: if isApproved() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /visits/{recordId} {
      allow read: if isApproved() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isApproved()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.officerName is string;
      allow update: if isApproved()
        && (isAdmin() || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId));
      allow delete: if isApproved() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // All other collections remain blocked by default.
  }
}
