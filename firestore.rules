rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isApproved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Create the first admin document manually in Firebase Console.
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'officer'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','name','employeeId','designation','branch','mobile','email','role','status','createdAt','passwordChangedAt']);
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /{collectionName}/{recordId} {
      allow read: if collectionName in ['customers','surveys','visits'] && isApproved()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if collectionName in ['customers','surveys','visits'] && isApproved()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.officerName is string;
      allow update: if collectionName in ['customers','surveys','visits'] && isApproved()
        && (isAdmin() || resource.data.ownerId == request.auth.uid)
        && (isAdmin() || (request.resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId));
      allow delete: if collectionName in ['customers','surveys','visits'] && isApproved()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }
  }
}
